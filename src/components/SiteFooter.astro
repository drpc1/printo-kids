---
// Anonymous Google Form outside the app: the parent fills it in voluntarily, nothing from the device is sent (GitHub 292).
const FEEDBACK_FORM_URL = "https://forms.gle/cgw7HiNhspN73CPV8";
const linkClass =
  "focus-visible:border-ring focus-visible:ring-ring/50 inline-flex min-h-11 items-center rounded-md px-3 text-base text-muted-foreground underline underline-offset-4 outline-none hover:text-foreground focus-visible:ring-[3px]";
---

<footer class="flex w-full flex-wrap justify-center gap-x-2 pt-4 print:hidden">
  <a href="/how-it-works" class:list={linkClass}>
    Jak to działa
  </a>
  <a href={FEEDBACK_FORM_URL} target="_blank" rel="noopener noreferrer" class:list={linkClass}>
    Podziel się opinią<span class="sr-only"> (otwiera się w nowej karcie)</span>
  </a>
</footer>
