---
import WorksheetGenerator from "./WorksheetGenerator";
---

<main
  id="worksheet-home"
  class="flex min-h-dvh flex-col items-center justify-center bg-background px-6 py-20 text-foreground"
>
  <div class="flex w-full max-w-xl flex-col items-center gap-10 text-center">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">PrintoKids</h1>

    <p class="text-lg leading-relaxed text-muted-foreground sm:text-xl">
      Wygeneruj labirynt i wydrukuj go na kartce A4.
    </p>

    <WorksheetGenerator client:only="react" />
  </div>
</main>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  @media screen {
    #worksheet-home.has-maze {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #worksheet-home.has-maze .max-w-xl {
      gap: 1.5rem;
    }

    #worksheet-home.has-maze h1 {
      font-size: 1.5rem;
      line-height: 2rem;
    }

    #worksheet-home.has-maze p {
      display: none;
    }
  }

  @media screen and (max-width: 639px) {
    #worksheet-home.has-maze {
      padding-top: 3.5rem;
    }
  }

  @media print {
    html,
    body {
      height: auto !important;
      overflow: hidden;
    }

    #worksheet-home,
    #worksheet-home.has-maze {
      min-height: 0;
      padding: 0;
    }

    #worksheet-home .max-w-xl,
    #worksheet-home.has-maze .max-w-xl {
      max-width: none;
      gap: 0;
    }

    #worksheet-home h1,
    #worksheet-home p,
    #worksheet-home button {
      display: none;
    }

    #worksheet-home svg {
      display: block;
      overflow: hidden;
      /* iOS print ignores the zero page margin and adds printer margins; the sheet scales down into the printable area. */
      max-width: 100%;
      max-height: 100vh;
    }
  }
</style>
