---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

const tones: Record<Variant, string> = {
  info: "border-border bg-muted text-muted-foreground",
  warning: "border-accent bg-accent text-accent-foreground",
  error: "border-destructive bg-destructive text-destructive-foreground",
};
---

<div
  class:list={[
    "border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:text-inherit [&_a]:underline",
    tones[variant],
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
