---
import { buttonVariants } from "@/components/ui/button";
import { CARD_SKILLS, cardSkillLabels, cardsInCatalogOrder } from "@/lib/cards";
---

<div class="flex w-full flex-col gap-4">
  <!-- Hidden until the script runs: without JavaScript the catalog shows every card and no dead buttons. -->
  <div
    role="group"
    aria-labelledby="skill-filter-label"
    data-skill-filter
    hidden
    class="flex flex-wrap items-center justify-center gap-2"
  >
    <span id="skill-filter-label" class="w-full text-center text-sm font-medium text-muted-foreground">
      Co dziś ćwiczymy?
    </span>
    {[{ id: "wszystkie", label: "Wszystkie" }, ...CARD_SKILLS].map((skill) => (
      <button
        type="button"
        data-skill={skill.id}
        aria-pressed={skill.id === "wszystkie" ? "true" : "false"}
        class:list={[
          buttonVariants({ variant: "outline" }),
          "min-h-11 px-4 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:hover:bg-primary/90",
        ]}
      >
        {skill.label}
      </button>
    ))}
  </div>
  <ul class="grid w-full grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
    {cardsInCatalogOrder().map((kind) => (
      <li data-skills={kind.skills.join(" ")}>
        <a
          href={kind.href}
          data-card-title={kind.title}
          class="focus-visible:border-ring focus-visible:ring-ring/50 flex min-h-11 flex-col gap-4 rounded-md text-foreground outline-none focus-visible:ring-[3px]"
        >
          <div class="relative">
            <img
              src={kind.thumbnail}
              alt=""
              width="210"
              height="297"
              class="aspect-[210/297] h-auto w-full rounded-md border border-border bg-card object-contain"
            />
            <!-- Skills sit on the thumbnail as small tags: no extra row under the title, same names as the chips. -->
            <span
              aria-hidden="true"
              class="absolute top-1.5 left-1.5 flex max-w-[calc(100%-0.75rem)] flex-col items-start gap-1"
            >
              {cardSkillLabels(kind).map((label) => (
                <span class="rounded-full border border-border bg-background/90 px-2 py-0.5 text-xs leading-tight font-medium text-muted-foreground">
                  {label}
                </span>
              ))}
            </span>
            <span
              data-badge-for={kind.id}
              aria-hidden="true"
              hidden
              class="absolute -bottom-3 right-2 rounded-full bg-primary px-2.5 py-0.5 text-sm font-medium whitespace-nowrap text-primary-foreground ring-2 ring-background"
            />
          </div>
          <span class="text-center text-base font-medium sm:text-lg">{kind.title}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  import { catalogBadges, PROFILE_CHANGED_EVENT } from "@/lib/catalog-badges";

  // The catalog is rendered on the server and the profile lives in the browser, so the badges arrive after load.
  function showBadges(): void {
    let shown;
    try {
      shown = catalogBadges(localStorage);
    } catch {
      return;
    }

    for (const slot of document.querySelectorAll<HTMLElement>("[data-badge-for]")) {
      const text = shown.badges[slot.dataset.badgeFor ?? ""];
      slot.textContent = text ?? "";
      slot.hidden = text === undefined;
      // The badge is drawn over the thumbnail, so the link carries it in its name: "Sudoku, 6×6 · średni".
      const link = slot.closest("a");
      const title = link?.dataset.cardTitle;
      if (link !== null && title !== undefined) {
        if (text === undefined) {
          link.removeAttribute("aria-label");
        } else {
          link.setAttribute("aria-label", `${title}, ${text}`);
        }
      }
    }
  }

  // One choice, never remembered: not in storage, not in the address. Every visit and every return starts at "wszystkie".
  function applySkill(skill: string): void {
    for (const item of document.querySelectorAll<HTMLElement>("li[data-skills]")) {
      const skills = (item.dataset.skills ?? "").split(" ");
      item.hidden = skill !== "wszystkie" && !skills.includes(skill);
    }
    for (const chip of document.querySelectorAll<HTMLElement>("[data-skill]")) {
      chip.setAttribute("aria-pressed", String(chip.dataset.skill === skill));
    }
    const group = document.querySelector<HTMLElement>("[data-skill-filter]");
    if (group !== null) {
      group.hidden = false;
    }
  }

  for (const chip of document.querySelectorAll<HTMLElement>("[data-skill]")) {
    chip.addEventListener("click", () => {
      applySkill(chip.dataset.skill ?? "wszystkie");
    });
  }

  applySkill("wszystkie");
  showBadges();
  // Badges: a page restored from the browser cache and a profile changed in another tab both need a fresh read.
  // A restored page may come back with a chip chosen; the choice is not kept, so reset it first.
  window.addEventListener("pageshow", () => {
    applySkill("wszystkie");
    showBadges();
  });
  window.addEventListener("storage", showBadges);
  // The profile corner of this page changes the profile in this tab, where no storage event fires.
  window.addEventListener(PROFILE_CHANGED_EVENT, showBadges);
</script>
