---
interface Props {
  heading: string;
  description: string;
}

const { heading, description } = Astro.props;
---

<main
  id="worksheet-home"
  class="flex min-h-dvh flex-col items-center justify-center bg-background px-6 py-20 text-foreground"
>
  <a
    href="/"
    title="Wszystkie karty"
    aria-label="Wszystkie karty"
    class="text-muted-foreground hover:bg-accent hover:text-accent-foreground focus-visible:border-ring focus-visible:ring-ring/50 absolute top-4 left-4 z-40 inline-flex size-11 items-center justify-center rounded-md outline-none focus-visible:ring-[3px] print:hidden sm:pointer-fine:fixed"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="size-6"
    >
      <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
      <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
    </svg>
  </a>
  <div class="flex w-full max-w-xl flex-col items-center gap-10 text-center">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{heading}</h1>

    <p class="text-lg leading-relaxed text-muted-foreground sm:text-xl">{description}</p>

    <slot />
  </div>
</main>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  @media screen {
    #worksheet-home.has-sheet {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #worksheet-home.has-sheet .max-w-xl {
      gap: 1.5rem;
    }

    #worksheet-home.has-sheet h1 {
      font-size: 1.5rem;
      line-height: 2rem;
    }

    #worksheet-home.has-sheet .max-w-xl > p {
      display: none;
    }
  }

  @media screen and (max-width: 639px) {
    #worksheet-home.has-sheet {
      padding-top: 4.5rem;
    }
  }

  @media print {
    html,
    body {
      height: auto !important;
      overflow: hidden;
      /* Safari on iOS prints backgrounds; the screen color would frame the scaled-down sheet. */
      background: none;
    }

    #worksheet-home,
    #worksheet-home.has-sheet {
      min-height: 0;
      padding: 0;
      background: none;
    }

    #worksheet-home .max-w-xl,
    #worksheet-home.has-sheet .max-w-xl {
      max-width: none;
      gap: 0;
    }

    #worksheet-home h1,
    #worksheet-home p,
    #worksheet-home a,
    #worksheet-home button {
      display: none;
    }

    #worksheet-home svg {
      display: block;
      overflow: hidden;
      /* iOS print ignores the zero page margin and adds printer margins; the sheet scales down into the printable area. */
      max-width: 100%;
      max-height: 100vh;
    }
  }
</style>
