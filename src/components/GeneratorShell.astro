---
interface Props {
  description: string;
}

const { description } = Astro.props;
---

<main
  id="worksheet-home"
  class="flex min-h-dvh flex-col items-center justify-center bg-background px-6 py-20 text-foreground"
>
  <a
    href="/"
    class="text-muted-foreground hover:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 absolute top-4 left-4 z-40 inline-flex min-h-11 items-center rounded-md px-2 text-base outline-none focus-visible:ring-[3px] print:hidden sm:pointer-fine:fixed"
  >
    Wszystkie karty
  </a>
  <div class="flex w-full max-w-xl flex-col items-center gap-10 text-center">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">PrintoKids</h1>

    <p class="text-lg leading-relaxed text-muted-foreground sm:text-xl">{description}</p>

    <slot />
  </div>
</main>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  @media screen {
    #worksheet-home.has-maze {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #worksheet-home.has-maze .max-w-xl {
      gap: 1.5rem;
    }

    #worksheet-home.has-maze h1 {
      font-size: 1.5rem;
      line-height: 2rem;
    }

    #worksheet-home.has-maze .max-w-xl > p {
      display: none;
    }
  }

  @media screen and (max-width: 639px) {
    #worksheet-home.has-maze {
      padding-top: 4.5rem;
    }
  }

  @media print {
    html,
    body {
      height: auto !important;
      overflow: hidden;
      /* Safari on iOS prints backgrounds; the screen color would frame the scaled-down sheet. */
      background: none;
    }

    #worksheet-home,
    #worksheet-home.has-maze {
      min-height: 0;
      padding: 0;
      background: none;
    }

    #worksheet-home .max-w-xl,
    #worksheet-home.has-maze .max-w-xl {
      max-width: none;
      gap: 0;
    }

    #worksheet-home h1,
    #worksheet-home p,
    #worksheet-home a,
    #worksheet-home button {
      display: none;
    }

    #worksheet-home svg {
      display: block;
      overflow: hidden;
      /* iOS print ignores the zero page margin and adds printer margins; the sheet scales down into the printable area. */
      max-width: 100%;
      max-height: 100vh;
    }
  }
</style>
