---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="flex min-h-screen items-center justify-center bg-background p-4 text-foreground">
    <div class="rounded-2xl border border-border bg-card p-8 text-center text-card-foreground">
      <h1 class="mb-4 text-3xl font-bold text-foreground">Dashboard</h1>
      <p>
        Welcome, <span class="font-semibold">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-muted-foreground">This page is only for authenticated users.</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <Button type="submit" variant="outline">
          Sign out
        </Button>
      </form>
    </div>
  </div>
</Layout>
