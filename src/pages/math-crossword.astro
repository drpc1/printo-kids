---
import GeneratorShell from "@/components/GeneratorShell.astro";
import MathCrosswordGenerator from "@/components/MathCrosswordGenerator";
import Layout from "@/layouts/Layout.astro";
import { cardPageTitle, cardTitle } from "@/lib/cards";
---

<Layout title={cardPageTitle("krzyzowka")} lang="pl">
  <GeneratorShell
    heading={cardTitle("krzyzowka")}
    description="Wygeneruj krzyżówkę matematyczną i wydrukuj ją na kartce A4."
  >
    <MathCrosswordGenerator client:only="react" />
  </GeneratorShell>
</Layout>
