import OddOneOutGenerator from "@/components/OddOneOutGenerator";
import Layout from "@/layouts/Layout.astro";
import { cardPageTitle, cardTitle } from "@/lib/cards";
---

<Layout title={cardPageTitle("niepasuje")} lang="pl">
