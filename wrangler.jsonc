{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printo-kids",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Staging is built from main with CLOUDFLARE_ENV=staging (one build per environment).
  // Production (no CLOUDFLARE_ENV) is built from prod.
  "env": {
    "staging": {
      "name": "printo-kids-staging",
      "vars": {
        "ENVIRONMENT": "staging",
      },
    },
  },
}
